# Databases
# The starter world is shipped, so it is tracked (negated below). Any
# other *.db is a developer's own world and stays out of the repo.
*.db
*.db-shm
*.db-wal
*.db.bak-*
!moo/templates/starter/world.db

# macOS
.DS_Store

# Logs
*.log

# Python
__pycache__/
*.pyc
.pytest_cache/

# IDE/tools
.claude/
.agents/

# Checkpoint snapshots (runtime)
*_checkpoints/

# Written at startup so tooling can find a running server's API port.
# Runtime state (pid, port) — never part of the source tree.
*.db.api.json

# @dump output — local working files, not part of the source tree
dumps/

# @import staging area — source databases, not part of the tree
imports/

# Scratch verb tree for test.db -- try things here, then copy the file
# into "moo verbs/" once it works.  Keeping it out of git is the point:
# a scratch tree that gets committed is just a second real tree.
test verbs/

# Build artifacts
dist/
build/
*.egg-info/

# The local embedding model, and the tooling config that points at it.
# models/ is ~465 MB and has already cost this repository one
# git-filter-repo history rewrite (2026-06-23, model.onnx at 351 MB).
# Neither belongs in the tree, and neither was ignored until they turned
# up untracked in a worktree where one `git add -A` would have done it
# again.
models/
config.json
vectors.db

# starter reshape backups -- a copy of the template, not a change to it
*.pre-reshape
*.pre-reshape.[0-9]*
*.pre-reshape-shm
*.pre-reshape-wal
*.pre-reshape.[0-9]*-shm
*.pre-reshape.[0-9]*-wal
