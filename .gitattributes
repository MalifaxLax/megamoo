# Keep the release archive to what someone actually needs to run MegaMOO.
#
# `export-ignore` applies only to `git archive` -- the release zip. These
# files stay in the repository, on gh-pages, and in a clone; they are just
# not shipped in the download.

# Manual PDFs: regenerated by docs/manual/make-pdfs.sh, and the Markdown
# sources they are built from ship alongside them.
docs/manual/pdf/            export-ignore
docs/merchant-guide.pdf     export-ignore

# Guide website chrome. The guide HTML itself still ships; these are the
# social-preview image, the icons and the crawler files, which mean nothing
# outside the published site.
docs/guide/og-image.png         export-ignore
docs/guide/favicon.ico          export-ignore
docs/guide/apple-touch-icon.png export-ignore
docs/guide/robots.txt           export-ignore
docs/guide/sitemap.xml          export-ignore

# Vendored Lua interpreter for the browser client's optional scripting host.
# NOTE: omitting this from the archive disables *Lua* player scripting in the
# web client; JavaScript scripting is unaffected. Fetch web/vendor/wasmoon
# from the repository to restore it.
web/vendor/wasmoon/         export-ignore
